# okra-clip-archiver config. Copy this to ".env" and put it next to the app (in
# the install folder), or run the app from a folder that contains it.
#
# Twitch app credentials — create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your channel login (the part after twitch.tv/).
TWITCH_CHANNEL=your_channel
# Folder where OBS writes your recordings.
RECORDINGS_DIR=C:\Users\you\Videos
# Optional: reads the clipSync "clapperboard" anchors kennyBot writes.
# FIREBASE_DATABASE_URL=
